# Copy to .env.local and change the secret before deploying.
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: the first admin is created from these on first run.
ADMIN_EMAIL=admin@rentnaija.test
ADMIN_PASSWORD=Admin123!
# Set to "true" to skip admin review and publish new listings immediately.
AUTO_APPROVE_LISTINGS=false

# --- Only needed when deploying to a serverless host with no writable disk, e.g. Vercel ---
# Hosted database (Turso: https://turso.tech, free tier). Leave both unset for local dev or
# a host with a normal disk (Render, a VPS) — the app then uses a local SQLite file instead.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-token
#
# File storage for uploaded listing photos (Vercel Blob). Leave unset to save photos to the
# local disk instead (data/uploads). On Vercel, add the "Blob" storage from the dashboard and
# it sets this for you automatically.
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
